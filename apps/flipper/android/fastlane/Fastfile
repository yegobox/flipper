default_platform(:android)

# Gradle redirects build output to apps/flipper/build (see android/build.gradle.kts).
def release_aab_path
  android_dir = File.expand_path('..', __dir__)
  File.expand_path('../build/app/outputs/bundle/release/app-release.aab', android_dir)
end

def shorebird_cmd
  env_bin = ENV['SHOREBIRD_BIN']
  return env_bin if env_bin && !env_bin.empty? && File.executable?(env_bin)

  xdg = ENV['XDG_CONFIG_HOME']
  if xdg && !xdg.empty?
    xdg_bin = File.join(xdg, 'shorebird', 'bin', 'shorebird')
    return xdg_bin if File.executable?(xdg_bin)
  end

  home_bin = File.join(ENV['HOME'] || Dir.home, '.shorebird', 'bin', 'shorebird')
  return home_bin if File.executable?(home_bin)

  which = `command -v shorebird 2>/dev/null`.strip
  return which unless which.empty?

  UI.user_error!(
    'shorebird CLI not found. Install it in CI or locally: https://docs.shorebird.dev'
  )
end

def build_release_bundle
  # CI builds the Shorebird AAB in a dedicated workflow step (SHOREBIRD_PREBUILT).
  if ENV['SHOREBIRD_PREBUILT'] == 'true'
    aab = release_aab_path
    UI.user_error!("Shorebird AAB missing at #{aab}") unless File.exist?(aab)
    return
  end

  if ENV['USE_SHOREBIRD'] == 'true'
    if ENV['SHOREBIRD_TOKEN'].to_s.strip.empty?
      UI.user_error!(
        'SHOREBIRD_TOKEN is not set. Create an API key at https://console.shorebird.dev ' \
        '(Account → API Keys) and add it to GitHub Actions secrets.'
      )
    end

    sh "cd .. && #{shorebird_cmd} release android -v -- --no-android-gradle-daemon"
  else
    sh "cd .. && flutter build appbundle -- --no-android-gradle-daemon"
  end
end

platform :android do

  # The next free versionCode: one above the highest on any track. Uploads use
  # it instead of the CI run number, so builds from different workflows or
  # finishing out of order can never be rejected as a downgrade.
  desc "Write the next free Play versionCode to $NEXT_VERSION_CODE_FILE"
  lane :next_version_code do
    codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(
        package_name: 'rw.flipper',
        track: track,
        json_key_data: ENV['PLAY_STORE_CONFIG_JSON']
      )
    end
    UI.user_error!('Play returned no versionCodes; refusing to guess') if codes.empty?
    next_code = codes.map(&:to_i).max + 1
    File.write(ENV['NEXT_VERSION_CODE_FILE'] || 'next_version_code.txt', next_code.to_s)
    UI.message("Next versionCode: #{next_code}")
  end

  desc "Submit a new internal build to Google Play"
  lane :internal do 
  
    build_release_bundle

    # Build + release notes only, never the store listing. The preview
    # workflow writes metadata/android/en-US/changelogs/<code>.txt, and with
    # metadata on, supply also sent an en-US listing with no title, which
    # Play rejects for rw.flipper ("This app has no title for language
    # en-US"). Every preview upload failed that way after #804.
    upload = lambda do |notes|
      upload_to_play_store(
        package_name: 'rw.flipper',
        track: 'internal',
        aab: release_aab_path,
        json_key_data: ENV['PLAY_STORE_CONFIG_JSON'],
        skip_upload_metadata: true,
        skip_upload_changelogs: !notes,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
    begin
      upload.call(true)
    rescue StandardError => e
      # Testers need the build more than its notes: if Play refuses notes in
      # en-US too, ship without them rather than lose the upload.
      raise unless e.message =~ /language|title|release notes/i
      UI.important("Play refused the release notes (#{e.message}); uploading without them")
      upload.call(false)
    end
  end
  desc "Promote beta track to prod"
  lane :promote_to_production do
    upload_to_play_store(
      track: 'beta',
      package_name: 'rw.flipper',
      track_promote_to: 'production',
      skip_upload_changelogs: true,
      json_key_data: ENV['PLAY_STORE_CONFIG_JSON'],
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
      )
  end

  desc "Submit a new beta build to Google Play"
  lane :beta do
    build_release_bundle

    upload_to_play_store(
      track: 'beta',
      package_name: 'rw.flipper',
      aab: release_aab_path,
      json_key_data: ENV['PLAY_STORE_CONFIG_JSON'],
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Submit a new production build to Google Play"
  lane :production do
    build_release_bundle

    upload_to_play_store(
      track: 'production',
      package_name: 'rw.flipper',
      aab: release_aab_path,
      json_key_data: ENV['PLAY_STORE_CONFIG_JSON'],
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
