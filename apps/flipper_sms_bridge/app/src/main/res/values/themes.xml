<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The UI is Compose (ui/Theme.kt). This window theme only sets what shows
      before the first frame: no action bar, and the app's background colour
      so launch doesn't flash white-then-grey.
    -->
    <style name="Theme.SmsBridge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
